{
  "manifest_version": 3,
  "name": "X PWA Integration",
  "version": "1.0.0",
  "description": "Exposes X media state to Scroll and opens external links in the default browser.",
  "permissions": ["webNavigation"],
  "host_permissions": ["https://x.com/*", "https://*.x.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://*.x.com/*"],
      "js": ["logic.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
