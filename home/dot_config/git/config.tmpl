[credential "https://github.com"]
  helper = !gh auth git-credential

[core]
  autocrlf = input
  symlink = true
  pager = delta
{{ if (eq .chezmoi.os "windows") -}}
  sshCommand = "C:/Windows/System32/OpenSSH/ssh.exe"
{{ else if (.wsl) }}
  sshCommand = "//mnt/c/Windows/System32/OpenSSH/ssh.exe"
{{ else if eq .chezmoi.os "linux" }}
  sshCommand = "ssh -F ~/.ssh/config"
{{- end }}

[includeIf "gitdir:~/src/github.com/CyberAgent/"]
  path = ~/.config/git/cyberagent
[includeIf "gitdir:~/src/github.com/CyberAgentAI/"]
  path = ~/.config/git/cyberagent

[init]
  defaultBranch = main

[user]
  name = Koji AGAWA
  email = atty303@gmail.com
{{ if has "secrets" .roles }}
  signingkey = ~/.ssh/git_signing_ed25519
{{ end }}

[gpg]
  format = ssh

{{ if and (eq .chezmoi.os "windows") (has "secrets" .roles) }}
[gpg "ssh"]
  program = "C:/Windows/System32/OpenSSH/ssh-keygen.exe"
{{ end }}

[commit]
  gpgsign = {{ has "secrets" .roles }}

[interactive]
  diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    theme = Catppuccin Mocha

[merge]
    conflictStyle = zdiff3

[hook "hk-pre-commit"]
  command = test \"${HK:-1}\" = \"0\" || ! mise which hk >/dev/null 2>&1 || mise x -- hk run pre-commit --from-hook --staged
  event = pre-commit
[hook "hk-pre-push"]
  command = test \"${HK:-1}\" = \"0\" || ! mise which hk >/dev/null 2>&1 || mise x -- hk run pre-push --from-hook
  event = pre-push
[hook "hk-commit-msg"]
  command = test \"${HK:-1}\" = \"0\" || ! mise which hk >/dev/null 2>&1 || mise x -- hk run commit-msg --from-hook
  event = commit-msg
[hook "hk-prepare-commit-msg"]
  command = test \"${HK:-1}\" = \"0\" || ! mise which hk >/dev/null 2>&1 || mise x -- hk run prepare-commit-msg --from-hook
  event = prepare-commit-msg
[hook "hk-post-checkout"]
  command = test \"${HK:-1}\" = \"0\" || ! mise which hk >/dev/null 2>&1 || mise x -- hk run post-checkout --from-hook
  event = post-checkout
[hook "hk-post-commit"]
  command = test \"${HK:-1}\" = \"0\" || ! mise which hk >/dev/null 2>&1 || mise x -- hk run post-commit --from-hook
  event = post-commit
[hook "hk-post-merge"]
  command = test \"${HK:-1}\" = \"0\" || ! mise which hk >/dev/null 2>&1 || mise x -- hk run post-merge --from-hook
  event = post-merge
[hook "hk-post-rewrite"]
  command = test \"${HK:-1}\" = \"0\" || ! mise which hk >/dev/null 2>&1 || mise x -- hk run post-rewrite --from-hook
  event = post-rewrite
[hook "hk-pre-rebase"]
  command = test \"${HK:-1}\" = \"0\" || ! mise which hk >/dev/null 2>&1 || mise x -- hk run pre-rebase --from-hook
  event = pre-rebase
