# Output configuration
set $out_left DP-3
set $out_middle DP-1
set $out_right DP-2
set $out_tv HDMI-A-1

output $out_left {
    resolution 3840x2160
    position 0,0
    scale 1.25
    transform 270
    subpixel rgb
    layout_type vertical
    layout_default_width 1
    layout_default_height 0.5
}
output $out_middle {
    resolution 5120x1440
    position 1728,1220
    scale 1
    allow_tearing yes
    subpixel rgb
    render_bit_depth 10
    layout_type horizontal
    layout_default_width 0.33333333
    layout_default_height 1
}
output $out_right {
    resolution 3840x2160
    position 6848,0
    scale 1.25
    transform 90
    subpixel rgb
    layout_type vertical
    layout_default_width 1
    layout_default_height 0.5
}
output $out_tv {
    enable
    resolution 3840x2160
    position 8576,0
}

# Workspace rules
workspace secondary output $out_left
lua $lua_scripts/workspace_exec.lua secondary layout_default_width 1

workspace panel output $out_right
lua $lua_scripts/workspace_exec.lua panel workspace split v 0.66666666
lua $lua_scripts/workspace_exec.lua panel rename workspace 2 to strip
lua $lua_scripts/workspace_exec.lua panel layout_default_width 1
lua $lua_scripts/x_media.lua

#lua $lua_scripts/workspace_exec.lua 1 workspace split v 0.333333
workspace 1 output $out_middle
#lua $lua_scripts/workspace_exec.lua 1 layout_default_width 1

workspace --no-auto-back-and-forth 1

for_window [app_id="chrome-www.youtube.com__-Default"] {
    move container to workspace panel
    set_size h 1
    set_size v 0.33333333
}
for_window [app_id="chrome-x.com__-Default"] {
    move container to workspace strip
    set_size h 1
    set_size v 1
    scale_content 0.8
}
for_window [class="^steam$"] {
    move container to workspace panel
    set_size h 1
    set_size v 0.33333333
}
for_window [app_id="app.zen_browser.zen"] {
    move container to workspace 1
#    set_size h 1
}
for_window [app_id="obsidian"] {
    move container to workspace secondary
    set_size h 1
    set_size v 0.5
}
for_window [class="^Chatgpt$"] {
    move container to workspace secondary
    set_size h 1
    set_size v 0.5
}
for_window [app_id="gamescope"] {
    move container to workspace 1
    set_size v 1
    resize set width 2560px
    resize set height 1440px
}
for_window [shell="^xdg_shell$" title="^beatmania IIDX INFINITAS$"] {
    border none
    resize set width 1920px height 1080px
}
for_window [app_id="gamescope" title="Forza Horizon 6"] {
    move container to output $out_tv
    set_size v 1
    resize set width 3840px
    resize set height 2160px
    fullscreen enable
}
for_window [app_id="^steam_app_0$" title="^Arknights: Endfield$"] {
    move container to workspace 1
}
for_window [app_id="^steam_app_0$" title="^Endfield$"] {
    move container to workspace 1
    floating disable
    border none
    resize set width 2160px height 1440px
}
