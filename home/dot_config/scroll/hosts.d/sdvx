# Output roles
set $out_game HDMI-A-1
set $out_dashboard DP-1

output $out_game {
    resolution 3840x2160@120Hz
    position 0,0
    transform 90
    scale 1.5
    subpixel rgb
    allow_tearing yes
    layout_type vertical
    layout_default_width 1
    layout_default_height 1
}

output $out_dashboard {
    resolution 1920x1080@60Hz
    position 0,2560
    scale 1
    subpixel rgb
    layout_type horizontal
    layout_default_width 0.5
    layout_default_height 1
}

workspace game output $out_game
workspace dashboard output $out_dashboard

workspace --no-auto-back-and-forth game

# umu X11
for_window [class="^steam_app_sdvx$"] {
    border none
    move container to workspace game
}

# umu Wayland
for_window [shell="^xdg_shell$" app_id="^sv6c[.]exe$"] {
    border none
    move container to workspace game
    floating disable
    fullscreen enable
}

