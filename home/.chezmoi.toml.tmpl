{{- $osID := .chezmoi.os -}}
{{- if (and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id")) -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{- $wsl := (and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft")) -}}

{{- $knownRoles := list "development" "desktop" "gaming" "secrets" "work" -}}
{{- $defaultRoles := list "development" "secrets" -}}
{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "windows") -}}
{{-   $defaultRoles = list "development" "desktop" "secrets" -}}
{{- end -}}
{{- $installerDefaultRoles := env "CHEZMOI_ROLE_DEFAULTS" -}}
{{- if $installerDefaultRoles -}}
{{-   $defaultRoles = splitList "," $installerDefaultRoles -}}
{{- end -}}
{{- if hasKey . "roles" -}}
{{-   $defaultRoles = .roles -}}
{{- end -}}
{{- $roles := promptMultichoice "Roles" $knownRoles $defaultRoles -}}
{{- if ne (len $roles) (len (uniq $roles)) -}}
{{-   fail "roles must not contain duplicates" -}}
{{- end -}}
{{- range $role := $roles -}}
{{-   if not (has $role $knownRoles) -}}
{{-     fail (printf "unknown role: %s" $role) -}}
{{-   end -}}
{{- end -}}

{{- if stat (joinPath .chezmoi.homeDir "dotfiles") -}}
# Gitpod clone the repository to a this directory
sourceDir = {{ (joinPath .chezmoi.homeDir "dotfiles/home") | toToml }}
{{- else if (env "CODESPACES") -}}
# GitHub Codespaces clone the repository to a this directory
sourceDir = "/workspaces/.codespaces/.persistedshare/dotfiles/home"
{{- end }}

encryption = "age"

[age]
  identity = "~/.config/chezmoi/age/identity.txt"
  recipient = "age1hwzfym9sw8wjyckwfgul4qe6mn67h8rrkw9vfprl95nv3dd0qd7susuu8z"

[onepassword]
  prompt = false

[data]
    github_username = "atty303"
    osid = {{ $osID | quote }}
    roles = {{ $roles | toToml }}
    wsl = {{ $wsl }}
    zshPlugins = [
        "per-directory-history",
        "vi-mode",
        "zsh-syntax-highlighting",
    ]

[git]
    autoAdd = true
    autoCommit = false

[github]
    refreshPeriod = "12h"

{{ if eq .chezmoi.os "windows" }}
[interpreters.ps1]
    command = {{ joinPath (env "PROGRAMFILES") "PowerShell/7/pwsh.exe" | toToml }}
    args = ["-NoLogo"]
{{ end }}

# Run scripts after initializing the source state and before applying the state.
[hooks.read-source-state.pre]
{{ if eq .chezmoi.os "darwin" }}
    command = "/usr/bin/env"
    args = ["-S","bash", "-euo", "pipefail", {{ joinPath .chezmoi.sourceDir ".chezmoiscripts/darwin/.init.sh" | toToml }}]
{{ end }}
{{ if eq .chezmoi.os "linux" }}
    command = "/usr/bin/env"
    args = ["-S","bash", "-euo", "pipefail", {{ joinPath .chezmoi.sourceDir ".chezmoiscripts/linux/.init.sh" | toToml }}]
{{ end }}
{{ if eq .chezmoi.os "windows" }}
    command = {{ joinPath (env "SystemRoot") "System32/WindowsPowerShell/v1.0/powershell.exe" | toToml }}
    args = ["-NoLogo", {{ joinPath .chezmoi.sourceDir ".chezmoiscripts/windows/.init.ps1" | toToml }}]
{{ end }}
