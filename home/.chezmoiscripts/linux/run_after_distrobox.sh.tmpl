#!/usr/bin/env -S bash -euo pipefail

{{- $entries := list -}}
{{- if hasKey . "distrobox" -}}
{{-   $distrobox := index . "distrobox" -}}
{{-   if hasKey $distrobox "hosts" -}}
{{-     $hosts := index $distrobox "hosts" -}}
{{-     if hasKey $hosts .hostname -}}
{{-       $entries = (index $hosts .hostname).entries -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $scrollSelected := false -}}
{{- range $entry := $entries -}}
{{-   if eq $entry.name "scroll" -}}
{{-     $scrollSelected = true -}}
{{-   end -}}
{{- end }}
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/distrobox"
scroll_helper="${HOME}/.local/libexec/chezmoi-distrobox-scroll-update"
selected_entries=(
{{- range $entry := $entries }}
  {{ $entry.name | quote }}
{{- end }}
)

is_selected() {
  local candidate="${1:?candidate is required}"
  local selected

  for selected in "${selected_entries[@]}"; do
    [[ "$candidate" == "$selected" ]] && return 0
  done
  return 1
}

write_state() {
  local destination="${1:?destination is required}"
  local value="${2:?value is required}"
  local temporary="${destination}.tmp"

  printf '%s\n' "$value" >"$temporary"
  sync -f "$temporary"
  mv -f "$temporary" "$destination"
  sync -f "$state_dir"
}

if ((${#selected_entries[@]} == 0)) && [[ ! -d "$state_dir" ]]; then
  exit 0
fi
mkdir -p "$state_dir"

for applied_file in "$state_dir"/*.applied; do
  [[ -e "$applied_file" ]] || continue
  entry="${applied_file##*/}"
  entry="${entry%.applied}"
  if ! is_selected "$entry"; then
    if [[ "$entry" == scroll ]]; then
      continue
    fi
    rm -f "$applied_file" "$state_dir/${entry}.pending" "$state_dir/${entry}.failed"
  fi
done

{{ if not $scrollSelected -}}
"$scroll_helper" deselect
{{- end }}

if ((${#selected_entries[@]} == 0)); then
  exit 0
fi
if ! command -v distrobox >/dev/null 2>&1; then
  exit 0
fi

{{ if $scrollSelected -}}
systemctl --user daemon-reload
{{- end }}

{{ range $entry := $entries -}}
{{- $manifestPath := joinPath $.chezmoi.sourceDir "dot_config" "distrobox" "assemble" $entry.manifest -}}
{{- $manifestContent := include $manifestPath -}}
{{- $desired := sha256sum (printf "%s\n%s" $entry.name $manifestContent) }}
desired={{ $desired | quote }}
{{- if eq $entry.name "scroll" }}
"$scroll_helper" apply "$desired"
{{- else }}
applied_file="$state_dir/{{ $entry.name }}.applied"
applied=""
[[ ! -f "$applied_file" ]] || applied="$(<"$applied_file")"
if [[ "$applied" != "$desired" ]]; then
  distrobox assemble create --replace \
    --file "${XDG_CONFIG_HOME:-$HOME/.config}/distrobox/assemble/{{ $entry.manifest }}" \
    --name {{ $entry.name | quote }}
  write_state "$applied_file" "$desired"
fi
{{- end }}

{{ end -}}
