#!/bin/sh

set -eu

readonly expected_cpus=0-3,12-15
readonly cgroup_root="${GAME_EXCLUSIVE_CGROUP_ROOT:-/sys/fs/cgroup}"
readonly partition_path="$cgroup_root/game.slice"
readonly systemd_run="${GAME_EXCLUSIVE_SYSTEMD_RUN:-systemd-run}"

fail() {
  error=$1
  shift
  printf 'game-exclusive status=error error=%s %s\n' "$error" "$*" >&2
  exit 78
}

read_value() {
  path=$1
  [ -r "$path" ] || fail cgroup_file_unavailable "path=$path"
  cat "$path"
}

if [ "$#" -eq 0 ]; then
  printf 'usage: game-exclusive -- <command> [argument...]\n' >&2
  exit 64
fi
if [ "${1:-}" = -- ]; then
  shift
fi
[ "$#" -gt 0 ] || {
  printf 'usage: game-exclusive -- <command> [argument...]\n' >&2
  exit 64
}

partition=$(read_value "$partition_path/cpuset.cpus.partition")
exclusive=$(read_value "$partition_path/cpuset.cpus.exclusive.effective")
effective=$(read_value "$partition_path/cpuset.cpus.effective")
[ "$partition" = root ] || fail partition_state_invalid \
  "expected=root actual=$partition"
[ "$exclusive" = "$expected_cpus" ] || fail exclusive_cpus_invalid \
  "expected=$expected_cpus actual=$exclusive"
[ "$effective" = "$expected_cpus" ] || fail effective_cpus_invalid \
  "expected=$expected_cpus actual=$effective"

exec "$systemd_run" --system --scope --quiet --collect \
  --unit=game-exclusive.scope --slice=game.slice -- "$@"
