#!/usr/bin/env bash

set -euo pipefail

readonly host={{ .chezmoi.hostname | quote }}
readonly config_dir="${RESTIC_HOME_CONFIG_DIR:-$HOME/.config/restic}"
readonly credentials_file="$config_dir/credentials/$host.env"
readonly password_file="$config_dir/passwords/$host"
readonly exclude_file="$config_dir/excludes"
readonly restic_bin="${RESTIC_HOME_RESTIC_BIN:-$HOME/.local/bin/restic}"

require_private_file() {
  local path=$1
  local mode

  if [[ ! -f $path ]]; then
    printf 'missing restic configuration: %s\n' "$path" >&2
    return 1
  fi
  mode=$(stat -c '%a' "$path")
  if [[ $mode != 600 && $mode != 400 ]]; then
    printf 'restic configuration must have mode 600 or 400: %s has %s\n' "$path" "$mode" >&2
    return 1
  fi
}

load_credentials() {
  local line key value
  local access_key=false
  local secret_key=false
  local repository=false

  require_private_file "$credentials_file"
  require_private_file "$password_file"

  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    if [[ $line != *=* ]]; then
      printf 'invalid restic credential line in %s\n' "$credentials_file" >&2
      return 1
    fi
    key=${line%%=*}
    value=${line#*=}
    if [[ -z $value ]]; then
      printf 'empty restic credential: %s\n' "$key" >&2
      return 1
    fi
    case $key in
      AWS_ACCESS_KEY_ID)
        [[ $access_key == false ]] || { printf 'duplicate restic credential: %s\n' "$key" >&2; return 1; }
        access_key=true
        ;;
      AWS_SECRET_ACCESS_KEY)
        [[ $secret_key == false ]] || { printf 'duplicate restic credential: %s\n' "$key" >&2; return 1; }
        secret_key=true
        ;;
      RESTIC_REPOSITORY)
        [[ $repository == false ]] || { printf 'duplicate restic credential: %s\n' "$key" >&2; return 1; }
        repository=true
        ;;
      *)
        printf 'unsupported restic credential: %s\n' "$key" >&2
        return 1
        ;;
    esac
    export "$key=$value"
  done <"$credentials_file"

  if [[ $access_key != true || $secret_key != true || $repository != true ]]; then
    printf 'restic credentials must define AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and RESTIC_REPOSITORY\n' >&2
    return 1
  fi
  export RESTIC_PASSWORD_FILE="$password_file"
}

load_credentials

validate_action_args() {
  local action=$1 argument
  shift

  for argument in "$@"; do
    case $argument in
      --dry-run | --json | --quiet | -q | --verbose | -v)
        ;;
      *)
        printf 'unsupported option for restic-home %s: %s\n' "$action" "$argument" >&2
        return 1
        ;;
    esac
  done
}

case ${1-} in
  init)
    shift
    validate_action_args init "$@"
    exec "$restic_bin" --retry-lock={{ .restic.defaults.retry_lock | quote }} init "$@"
    ;;
  backup)
    shift
    validate_action_args backup "$@"
    [[ -f $exclude_file ]] || { printf 'missing restic exclude file: %s\n' "$exclude_file" >&2; exit 1; }
    exec "$restic_bin" --retry-lock={{ .restic.defaults.retry_lock | quote }} backup "$HOME" \
      --host "$host" --tag automatic --exclude-file "$exclude_file" \
      --exclude-caches --one-file-system "$@"
    ;;
  maintenance)
    shift
    validate_action_args maintenance "$@"
    exec "$restic_bin" --retry-lock={{ .restic.defaults.retry_lock | quote }} forget \
      --host "$host" --tag automatic \
      --keep-daily {{ .restic.defaults.keep_daily }} \
      --keep-weekly {{ .restic.defaults.keep_weekly }} \
      --keep-monthly {{ .restic.defaults.keep_monthly }} \
      --keep-yearly {{ .restic.defaults.keep_yearly }} \
      --prune "$@"
    ;;
  check)
    shift
    validate_action_args check "$@"
    exec "$restic_bin" --retry-lock={{ .restic.defaults.retry_lock | quote }} check \
      --read-data-subset={{ .restic.defaults.check_read_data_subset | quote }} "$@"
    ;;
  '')
    printf 'usage: restic-home {init|backup|maintenance|check|RESTIC_COMMAND...}\n' >&2
    exit 2
    ;;
  *)
    exec "$restic_bin" --retry-lock={{ .restic.defaults.retry_lock | quote }} "$@"
    ;;
esac
