#!/usr/bin/env bash

set -euo pipefail

readonly config_dir="${RESTIC_ARCHIVE_CONFIG_DIR:-$HOME/.config/restic}"
readonly credentials_file="$config_dir/credentials/manual-archives.env"
readonly password_file="$config_dir/passwords/manual-archives"
readonly restic_bin="${RESTIC_ARCHIVE_RESTIC_BIN:-$HOME/.local/bin/restic}"
readonly state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/restic-archive"
readonly success_limit={{ .restic.archive.record_success_limit }}
readonly failure_limit={{ .restic.archive.record_failure_limit }}

recording_enabled=false
recording_complete=complete
run_id=
run_file=
operation=unknown
archive_id=
manifest_digest=
started_at=
diagnostic_error_type=
backup_dry_run=false

case ${1-} in
  init | backup | check | snapshots | ls | stats | find | restore | dump)
    operation=$1
    ;;
esac

require_private_file() {
  local path=$1
  local mode

  if [[ ! -f $path || -L $path ]]; then
    printf 'missing regular restic archive configuration: %s\n' "$path" >&2
    return 1
  fi
  mode=$(stat -c '%a' "$path")
  if [[ $mode != 600 && $mode != 400 ]]; then
    printf 'restic archive configuration must have mode 600 or 400: %s has %s\n' \
      "$path" "$mode" >&2
    return 1
  fi
}

load_credentials() {
  local line key value
  local access_key=false
  local secret_key=false
  local repository=false

  require_private_file "$credentials_file" || return 1
  require_private_file "$password_file" || return 1

  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    if [[ $line != *=* ]]; then
      printf 'invalid restic archive credential line in %s\n' "$credentials_file" >&2
      return 1
    fi
    key=${line%%=*}
    value=${line#*=}
    if [[ -z $value ]]; then
      printf 'empty restic archive credential: %s\n' "$key" >&2
      return 1
    fi
    case $key in
      AWS_ACCESS_KEY_ID)
        [[ $access_key == false ]] || {
          printf 'duplicate restic archive credential: %s\n' "$key" >&2
          return 1
        }
        access_key=true
        ;;
      AWS_SECRET_ACCESS_KEY)
        [[ $secret_key == false ]] || {
          printf 'duplicate restic archive credential: %s\n' "$key" >&2
          return 1
        }
        secret_key=true
        ;;
      RESTIC_REPOSITORY)
        [[ $repository == false ]] || {
          printf 'duplicate restic archive credential: %s\n' "$key" >&2
          return 1
        }
        repository=true
        ;;
      *)
        printf 'unsupported restic archive credential field\n' >&2
        return 1
        ;;
    esac
    export "$key=$value"
  done <"$credentials_file"

  if [[ $access_key != true || $secret_key != true || $repository != true ]]; then
    printf 'restic archive credentials must define AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and RESTIC_REPOSITORY\n' >&2
    return 1
  fi
  export RESTIC_PASSWORD_FILE="$password_file"
}

record_field() {
  local key=$1
  local value=$2

  [[ $recording_enabled == true ]] || return 0
  if [[ $key == *[$'\n\r=']* || $value == *[$'\n\r']* ]]; then
    recording_complete=partial
    return 1
  fi
  if ! { printf '%s=%s\n' "$key" "$value" >>"$run_file"; } 2>/dev/null; then
    recording_complete=partial
    return 1
  fi
}

prune_records() {
  local suffix=$1
  local limit=$2
  local -a records=()
  local index

  mapfile -d '' records < <(
    find "$state_dir/runs" -maxdepth 1 -type f -name "*.$suffix" \
      -printf '%T@ %p\0' 2>/dev/null | sort -z -n
  )
  for ((index = 0; index < ${#records[@]} - limit; index++)); do
    rm -f -- "${records[index]#* }" || true
  done
}

start_recording() {
  local recording=${RESTIC_ARCHIVE_RECORDING:-on}

  case $recording in
    on)
      ;;
    off)
      return 0
      ;;
    *)
      printf 'RESTIC_ARCHIVE_RECORDING must be on or off\n' >&2
      return 2
      ;;
  esac

  umask 077
  if ! mkdir -p "$state_dir/runs" || ! chmod 700 "$state_dir" "$state_dir/runs"; then
    return 0
  fi
  prune_records pending "$failure_limit"
  prune_records partial "$failure_limit"
  run_file=$(mktemp "$state_dir/runs/run-XXXXXXXX.pending") || {
    return 0
  }
  run_id=${run_file##*/run-}
  run_id=${run_id%.pending}
  started_at=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
  recording_enabled=true
  record_field schema_version 1 || true
  record_field run_id "$run_id" || true
  record_field resource_name restic-archive || true
  record_field resource_version 1 || true
  record_field operation "$operation" || true
  record_field started_at "$started_at" || true
}

error_type_for_status() {
  case $1 in
    0) printf 'none\n' ;;
    3) printf 'source_incomplete\n' ;;
    10) printf 'repository_missing\n' ;;
    11) printf 'repository_locked\n' ;;
    12) printf 'password_invalid\n' ;;
    *) printf 'operation_failed\n' ;;
  esac
}

finish_recording() {
  local status=$1
  local outcome=success
  local destination
  local record_ok=true

  [[ $recording_enabled == true ]] || return 0
  if ((status != 0)); then
    outcome=error
  fi
  record_field archive_id "$archive_id" || record_ok=false
  record_field manifest_sha256 "$manifest_digest" || record_ok=false
  if [[ $operation == backup ]]; then
    record_field dry_run "$backup_dry_run" || record_ok=false
  fi
  record_field status "$outcome" || record_ok=false
  if [[ -n $diagnostic_error_type ]]; then
    record_field error_type "$diagnostic_error_type" || record_ok=false
  else
    record_field error_type "$(error_type_for_status "$status")" || record_ok=false
  fi
  record_field exit_code "$status" || record_ok=false
  record_field finished_at "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" || record_ok=false
  if [[ $recording_complete != complete ]]; then
    record_ok=false
  fi
  record_field recording_completeness "$recording_complete" || record_ok=false
  if [[ $record_ok != true ]]; then
    mv -- "$run_file" "${run_file%.pending}.partial" 2>/dev/null || true
    prune_records partial "$failure_limit"
    return 0
  fi
  destination=${run_file%.pending}.$outcome
  if ! mv -- "$run_file" "$destination" 2>/dev/null; then
    return 0
  fi
  prune_records success "$success_limit"
  prune_records error "$failure_limit"
}

run_restic() {
  local status=0

  "$restic_bin" --retry-lock={{ .restic.defaults.retry_lock | quote }} "$@" || status=$?
  finish_recording "$status"
  return "$status"
}

validate_archive_id() {
  [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]
}

validate_manifest() {
  local manifest=$1
  local path

  if [[ ! -f $manifest || -L $manifest ]]; then
    printf 'archive manifest must be a regular file: %s\n' "$manifest" >&2
    return 1
  fi
  if [[ ! -s $manifest ]]; then
    printf 'archive manifest must not be empty: %s\n' "$manifest" >&2
    return 1
  fi
  while IFS= read -r path || [[ -n $path ]]; do
    if [[ $path != /* ]]; then
      printf 'archive manifest paths must be absolute: %s\n' "$path" >&2
      return 1
    fi
  done <"$manifest"
}

start_recording || exit $?
if ! load_credentials; then
  diagnostic_error_type=configuration_invalid
  finish_recording 1
  exit 1
fi

case ${1-} in
  init)
    shift
    if (($#)); then
      printf 'usage: restic-archive init\n' >&2
      diagnostic_error_type=invalid_argument
      finish_recording 2
      exit 2
    fi
    run_restic init
    ;;
  backup)
    shift
    if (($# < 2)); then
      printf 'usage: restic-archive backup ARCHIVE_ID MANIFEST [--dry-run|--quiet|--verbose]\n' >&2
      diagnostic_error_type=invalid_argument
      finish_recording 2
      exit 2
    fi
    candidate_archive_id=$1
    manifest=$2
    shift 2
    if ! validate_archive_id "$candidate_archive_id"; then
      printf 'archive ID must contain only lowercase letters, digits, and hyphens\n' >&2
      diagnostic_error_type=invalid_argument
      finish_recording 2
      exit 2
    fi
    archive_id=$candidate_archive_id
    if ! validate_manifest "$manifest"; then
      diagnostic_error_type=manifest_invalid
      finish_recording 2
      exit 2
    fi
    for argument in "$@"; do
      case $argument in
        --dry-run)
          backup_dry_run=true
          ;;
        --quiet | -q | --verbose | -v)
          ;;
        *)
          printf 'unsupported option for restic-archive backup: %s\n' "$argument" >&2
          diagnostic_error_type=invalid_argument
          finish_recording 2
          exit 2
          ;;
      esac
    done
    manifest_digest=$(sha256sum "$manifest" | cut -d ' ' -f 1)
    run_restic backup \
      --host "$archive_id" \
      --tag manual-archive \
      --tag "$archive_id" \
      --files-from-verbatim "$manifest" \
      --exclude-caches \
      --one-file-system \
      "$@" \
      "$manifest"
    ;;
  check)
    shift
    if (($#)); then
      printf 'usage: restic-archive check\n' >&2
      diagnostic_error_type=invalid_argument
      finish_recording 2
      exit 2
    fi
    run_restic check
    ;;
  restore)
    shift
    for argument in "$@"; do
      case $argument in
        --delete | --delete=*)
          printf 'restic-archive restore does not allow --delete\n' >&2
          diagnostic_error_type=invalid_argument
          finish_recording 2
          exit 2
          ;;
      esac
    done
    run_restic restore "$@"
    ;;
  snapshots | ls | stats | find | dump)
    command=$1
    shift
    run_restic "$command" "$@"
    ;;
  '')
    printf 'usage: restic-archive {init|backup|check|snapshots|ls|stats|find|restore|dump}\n' >&2
    diagnostic_error_type=invalid_argument
    finish_recording 2
    exit 2
    ;;
  *)
    printf 'unsupported restic-archive action\n' >&2
    diagnostic_error_type=invalid_argument
    finish_recording 2
    exit 2
    ;;
esac
