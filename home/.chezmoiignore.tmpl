.yarn/
src/

.CFUserTextEncoding
.vim/
.viminfo
.yarnrc
.config/chezmoi/
.config/github-copilot/
.config/op/
.config/zellij/config.kdl.bak*
.config/Code/User/managed/settings.json
.config/Code/User/managed/keybindings.json
.lesshst
.javacpp/
.cups/
.gnupg/

.aws/boto/
.aws/cli/
.zcompdump
.config/carapace/bridge/zsh/.zcompdump_capture
.config/nushell/history.*
.bash_history
.node_repl_history
.config/karabiner/assets
.config/karabiner/automatic_backups
.config/jgit/
.config/configstore/update-notifier-yo.json
.config/carapace/overlays
.config/carapace/specs
.config/configstore/

{{ if ne .chezmoi.os "windows" }}
.config/alacritty/windows.toml
{{ end }}

# Linux
.local/share/fonts/
{{ if or (ne .chezmoi.os "linux") (not (has "desktop" .roles)) }}
.var/app/io.mpv.Mpv/
{{ end }}
{{ if not (has "desktop" .roles) }}
.config/chrome-web-apps/
.local/bin/chrome-web-app
.local/bin/open-in-default-browser
.local/share/applications/chrome-web-app-*.desktop
.local/share/applications/open-in-default-browser.desktop
.local/share/icons/hicolor/*/apps/chrome-web-app-*.png
{{ end }}
{{ if or (ne .chezmoi.os "linux") (ne .chezmoi.arch "amd64") (not (has "desktop" .roles)) (not (or (eq .chezmoi.osRelease.id "fedora") (contains "fedora" .chezmoi.osRelease.idLike))) }}
.local/bin/chatgpt
.local/libexec/chatgpt-update
.local/share/applications/chatgpt.desktop
.local/share/chatgpt/
{{ end }}
