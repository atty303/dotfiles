{{- /* chezmoi:modify-template */ -}}
{{- $begin := "# BEGIN chezmoi managed SSH config v2\n" -}}
{{- $end := "# END chezmoi managed SSH config v2\n" -}}
{{- $input := .chezmoi.stdin -}}
{{- $outside := "" -}}
{{- if eq $input "" -}}
{{- else if hasPrefix $begin $input -}}
{{-   $parts := splitList $end $input -}}
{{-   if or (ne (len $parts) 2) (ne (len (splitList $begin $input)) 2) -}}
{{-     fail "SSH config has ambiguous chezmoi block markers; no changes made" -}}
{{-   end -}}
{{-   $outside = index $parts 1 -}}
{{- else -}}
{{-   fail "SSH config has no managed block; no changes made" -}}
{{- end -}}
{{- $begin -}}
{{- includeTemplate "ssh-config" . -}}
{{- $end -}}
{{- $outside -}}
